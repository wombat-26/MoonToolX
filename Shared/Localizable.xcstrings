    "“As in the Sky” rotates the moon image the way you see the Moon from your location: zenith up.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wie am Himmel“ dreht das Mondbild so, wie Sie den Mond an Ihrem Standort sehen: Zenit oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Como en el cielo» gira la imagen de la Luna tal como ves la Luna desde tu ubicación: el cenit arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Comme dans le ciel » fait pivoter l’image de la Lune telle que vous voyez la Lune depuis votre position : zénith en haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Come in cielo» ruota l’immagine della Luna come vedi la Luna dalla tua posizione: zenit in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「空での見え方」では、現在地から見える向きに月の画像を回転させます（天頂が上）。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Zoals aan de hemel’ draait de maanafbeelding zoals je de maan vanaf je locatie ziet: zenit boven."
          }
        }
      }
    }
  },
  "version": "1.0"
}