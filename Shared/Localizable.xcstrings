    "Next principal phases plus perigee (closest point to Earth) and apogee (farthest point from Earth), in local time.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächste Hauptphasen sowie Perigäum (erdnächster Punkt) und Apogäum (erdfernster Punkt), in Ortszeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximas fases principales, además del perigeo (punto más cercano a la Tierra) y el apogeo (punto más lejano), en hora local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prochaines phases principales ainsi que le périgée (point le plus proche de la Terre) et l’apogée (point le plus éloigné), en heure locale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prossime fasi principali, oltre al perigeo (punto più vicino alla Terra) e all’apogeo (punto più lontano), in ora locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の主な月相と、近地点（地球に最も近い点）・遠地点（最も遠い点）を現地時間で表示します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgende hoofdfasen plus perigeum (dichtstbijzijnde punt bij de aarde) en apogeum (verste punt), in lokale tijd."
          }
        }
      }
    },
