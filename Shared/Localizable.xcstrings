        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle tijden gebruiken de tijdzone die in macOS is ingesteld."
          }
        }
      }
    },
    "Allow MoonToolX access in System Settings under Privacy & Security › Location Services.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie MoonToolX den Zugriff in den Systemeinstellungen unter Datenschutz & Sicherheit › Ortungsdienste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso de MoonToolX en Ajustes del Sistema, en Privacidad y seguridad › Localización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès de MoonToolX dans Réglages Système, sous Confidentialité et sécurité › Service de localisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l’accesso a MoonToolX in Impostazioni di Sistema, in Privacy e sicurezza › Localizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定の「プライバシーとセキュリティ › 位置情報サービス」で MoonToolX へのアクセスを許可してください。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef MoonToolX toegang in Systeeminstellingen bij Privacy en beveiliging › Locatievoorzieningen."
          }
        }
      }
    },
    "Altitude of the Moon’s center above (+) or below (−) the horizon at your Mac’s location, without atmospheric refraction, and compass direction with azimuth (from north through east).": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhe des Mondmittelpunkts über (+) oder unter (−) dem Horizont am Mac-Standort, ohne Lichtbrechung der Atmosphäre, und Himmelsrichtung mit Azimut (von Nord über Ost)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura del centro de la Luna sobre (+) o bajo (−) el horizonte en la ubicación de tu Mac, sin refracción atmosférica, y dirección con el acimut (de norte a este)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauteur du centre de la Lune au-dessus (+) ou au-dessous (−) de l’horizon à la position de votre Mac, sans réfraction atmosphérique, et direction avec l’azimut (du nord vers l’est)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza del centro della Luna sopra (+) o sotto (−) l’orizzonte nella posizione del tuo Mac, senza rifrazione atmosferica, e direzione con l’azimut (da nord verso est)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac の位置における月の中心の地平線からの高度（上が＋、下が−、大気差なし）と、方角および方位角（北から東回り）。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogte van het middelpunt van de maan boven (+) of onder (−) de horizon op de locatie van je Mac, zonder atmosferische refractie, en windrichting met azimut (van noord via oost)."
          }
        }
      }
    },
    "Altitude of the Moon’s center above the horizon at your location, without atmospheric refraction: + above the horizon, − below it. Also the compass direction (N, NNE, NE … NNW) and the azimuth in degrees, counted from north through east (east = 90°, south = 180°). When the Moon is below the horizon, the direction shows where it is below the horizon.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhe des Mondmittelpunkts über dem Horizont an Ihrem Standort, ohne Lichtbrechung der Atmosphäre: + über dem Horizont, − darunter. Dazu die Himmelsrichtung (N, NNO, NO … NNW) und der Azimut in Grad, von Nord über Ost gezählt (Ost = 90°, Süd = 180°). Steht der Mond unter dem Horizont, zeigt die Richtung, wo er sich unter dem Horizont befindet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura del centro de la Luna sobre el horizonte en tu ubicación, sin refracción atmosférica: + sobre el horizonte, − por debajo. Además, la dirección (N, NNE, NE … NNO) y el acimut en grados, contado de norte a este (este = 90°, sur = 180°). Cuando la Luna está bajo el horizonte, la dirección indica dónde se encuentra bajo el horizonte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauteur du centre de la Lune au-dessus de l’horizon à votre position, sans réfraction atmosphérique : + au-dessus de l’horizon, − au-dessous. Également la direction (N, NNE, NE … NNO) et l’azimut en degrés, compté du nord vers l’est (est = 90°, sud = 180°). Lorsque la Lune est sous l’horizon, la direction indique où elle se trouve sous l’horizon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza del centro della Luna sopra l’orizzonte nella tua posizione, senza rifrazione atmosferica: + sopra l’orizzonte, − sotto. Inoltre la direzione (N, NNE, NE … NNO) e l’azimut in gradi, contato da nord verso est (est = 90°, sud = 180°). Quando la Luna è sotto l’orizzonte, la direzione indica dove si trova sotto l’orizzonte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地における月の中心の地平線からの高度（大気差なし）：地平線より上は＋、下は−。あわせて方角（北、北北東、北東 … 北北西）と、北から東回りに数えた方位角（度、東 = 90°、南 = 180°）を表示します。月が地平線より下にあるときは、地平線の下のどの方向にあるかを示します。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoogte van het middelpunt van de maan boven de horizon op je locatie, zonder atmosferische refractie: + boven de horizon, − eronder. Daarnaast de windrichting (N, NNO, NO … NNW) en het azimut in graden, gerekend van noord via oost (oost = 90°, zuid = 180°). Staat de maan onder de horizon, dan geeft de richting aan waar hij zich onder de horizon bevindt."
          }
        }
      }
    },
