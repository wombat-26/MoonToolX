    "All times use the time zone set in macOS.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zeiten in der Zeitzone, die in macOS eingestellt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las horas usan la zona horaria configurada en macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les heures utilisent le fuseau horaire défini dans macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli orari usano il fuso orario impostato in macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての時刻は macOS で設定されたタイムゾーンで表示されます。"
