    "How large the Moon appears in the sky, in arcminutes (60 arcminutes = 1 degree), seen from your location.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So groß erscheint der Mond am Himmel, in Bogenminuten (60 Bogenminuten = 1 Grad), von Ihrem Standort aus gesehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño con el que se ve la Luna en el cielo, en minutos de arco (60 minutos de arco = 1 grado), vista desde tu ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille apparente de la Lune dans le ciel, en minutes d’arc (60 minutes d’arc = 1 degré), vue de votre position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto appare grande la Luna in cielo, in minuti d’arco (60 minuti d’arco = 1 grado), vista dalla tua posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地から見た空での月の大きさ（分角、60 分角 = 1 度）。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe groot de maan aan de hemel lijkt, in boogminuten (60 boogminuten = 1 graad), gezien vanaf je locatie."
          }
        }
      }
    },
    "How long light takes to travel from the Moon to the Earth.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So lange braucht das Licht vom Mond zur Erde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo que tarda la luz en llegar de la Luna a la Tierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps que met la lumière pour aller de la Lune à la Terre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo che impiega la luce per andare dalla Luna alla Terra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光が月から地球に届くまでの時間です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe lang het licht erover doet om van de maan naar de aarde te reizen."
          }
        }
      }
    },
    "JPL DE440 (NASA Jet Propulsion Laboratory), valid from 2020 to 2099. The calculation is far more precise than the meters displayed.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JPL DE440 (NASA Jet Propulsion Laboratory), gültig von 2020 bis 2099. Die Berechnung ist weitaus genauer als die angezeigten Meter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "JPL DE440 (NASA Jet Propulsion Laboratory), válidas de 2020 a 2099. El cálculo es mucho más preciso que los metros mostrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "JPL DE440 (NASA Jet Propulsion Laboratory), valables de 2020 à 2099. Le calcul est bien plus précis que les mètres affichés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "JPL DE440 (NASA Jet Propulsion Laboratory), valide dal 2020 al 2099. Il calcolo è molto più preciso dei metri visualizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JPL DE440（NASA ジェット推進研究所）、2020年から2099年まで有効。計算は表示されるメートル単位よりはるかに高精度です。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "JPL DE440 (NASA Jet Propulsion Laboratory), geldig van 2020 tot 2099. De berekening is veel nauwkeuriger dan de getoonde meters."
          }
        }
      }
    },
