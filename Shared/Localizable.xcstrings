    "Search for **MoonToolX**, choose a size (small, medium, or large), and drag the widget to where you want it.": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen Sie nach **MoonToolX**, wählen Sie die Größe (klein, mittel oder groß) und ziehen Sie das Widget an die gewünschte Stelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca **MoonToolX**, elige un tamaño (pequeño, mediano o grande) y arrastra el widget a la posición deseada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez **MoonToolX**, choisissez une taille (petite, moyenne ou grande) et faites glisser le widget à l’emplacement souhaité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca **MoonToolX**, scegli una dimensione (piccola, media o grande) e trascina il widget nella posizione desiderata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「**MoonToolX**」を検索し、サイズ（小・中・大）を選んで、ウィジェットを好きな場所にドラッグします。"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek naar **MoonToolX**, kies een formaat (klein, middelgroot of groot) en sleep de widget naar de gewenste plek."
          }
        }
      }
    },
